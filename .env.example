# Copy this file to .env and fill in your own values.
# Get a free/cheap API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model slug from https://openrouter.ai/models
# A free-tier model works fine for translation.
TRANSLATE_MODEL=nvidia/nemotron-3.5-lightning:free

# Postgres connection string (e.g. from Neon: https://console.neon.tech).
# If unset, the app falls back to a local SQLite file for convenience.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Note attachments (images/documents), via Supabase Storage
# (https://supabase.com -> Project Settings -> API Keys -> Secret keys).
# If unset, the attachment feature is disabled.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key
ATTACHMENTS_BUCKET=notetaker-attachments
