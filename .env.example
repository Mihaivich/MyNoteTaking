# Copy this file to .env and fill in your own values.
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any Gemini model ID. gemini-3.5-flash-lite is free-tier eligible and,
# in testing, noticeably faster and more reliable under load than the
# full gemini-3.8-flash model (~3s vs. 6-70s per call, some of which
# failed outright - looked like free-tier rate limiting).
GEMINI_MODEL=gemini-3.5-flash-lite

# Postgres connection string (e.g. from Neon: https://console.neon.tech).
# If unset, the app falls back to a local SQLite file for convenience.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Note attachments (images/documents), via Supabase Storage
# (https://supabase.com -> Project Settings -> API Keys -> Secret keys).
# If unset, the attachment feature is disabled.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key
ATTACHMENTS_BUCKET=notetaker-attachments
